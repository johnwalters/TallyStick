{
  "name": "tallystick",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:balance-sheet-fixtures": "node scripts/validate-balance-sheet-fixtures.mjs",
    "test:cash-flow-fixtures": "node scripts/validate-cash-flow-fixtures.mjs && node scripts/run-cash-flow-production-gate.mjs",
    "test:ci": "npm run test:boundaries && npm run test:balance-sheet-fixtures && npm run test:cash-flow-fixtures && ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:contract": "ng test --watch=false --browsers=ChromeHeadless",
    "test:fixtures": "npm run test:balance-sheet-fixtures && ng test --watch=false --browsers=ChromeHeadless",
    "test:integration": "ng test --watch=false --browsers=ChromeHeadless",
    "test:angular": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "ng test --watch=false --browsers=ChromeHeadless",
    "desktop:build": "tsc -p tsconfig.desktop.json",
    "desktop:package": "ng build && tsc -p tsconfig.desktop.json && node scripts/package-desktop.mjs",
    "test:desktop-host": "npm run desktop:build && node --test dist/desktop-host/database-lifecycle.node-test.js",
    "desktop:start": "ng build && tsc -p tsconfig.desktop.json && node scripts/package-desktop.mjs && node scripts/launch-desktop.mjs",
    "desktop:launch": "node scripts/launch-desktop.mjs",
    "desktop:launch:electron": "electron .",
    "desktop:smoke": "ng build && tsc -p tsconfig.desktop.json && npm run desktop:smoke:launch",
    "desktop:smoke:launch": "ACCOUNTING_DESKTOP_SMOKE=1 electron ."
  },
  "private": true,
  "main": "dist/desktop-host/main.js",
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "fast-xml-parser": "^5.10.1",
    "papaparse": "^5.5.4",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.0",
    "@electron/packager": "^18.4.4",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "electron": "^43.3.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
